# ═══════════════════════════════════════════════════
# Configuration Backend - Portfolio Tsitana Khyme
# ═══════════════════════════════════════════════════

# Port du serveur
PORT=3000

# Email configuration (Gmail)
# Créer un mot de passe d'application : https://myaccount.google.com/apppasswords
EMAIL_USER=tsitanakhyme@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_gmail

# Email destinataire (où les messages du formulaire seront envoyés)
RECIPIENT_EMAIL=tsitanakhyme@gmail.com

# CORS - Origine autorisée (URL de votre site frontend en production)
CORS_ORIGIN=http://localhost:5500,https://tsitanakhyme.com

# Environment (development ou production)
NODE_ENV=development
